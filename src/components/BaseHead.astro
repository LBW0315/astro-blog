---
// <head> の中身（すべてのページで共通）
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { AUTHOR_NAME, SITE_TITLE } from '../consts';
import { fontCssVersion } from '../lib/font-css';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = FallbackImage } = Astro.props;

// アクセス解析（Google Analytics 4）の測定 ID。ページのソースに出る公開情報なので、そのまま書いています
const GA_ID = 'G-7N06JTSXTQ';
// 読み込み直後に動かす小さなスクリプト（下の <script set:html> で出力する）
const gaScript = `
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
gtag('js', new Date());
gtag('config', '${GA_ID}', { send_page_view: false });
if (!window.__gaPageView) {
	window.__gaPageView = true;
	document.addEventListener('astro:page-load', function () {
		gtag('event', 'page_view', { page_title: document.title, page_location: location.href });
	});
}
`.trim();
---

<!-- 基本情報 -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- アイコン：SVG に対応したブラウザは favicon.svg、古いブラウザは favicon.ico、iPhone のホーム画面は apple-touch-icon.png
     ?v= の数字は、アイコンを作り直したときに増やす（ブラウザに保存された古いアイコンを使わせないため） -->
<link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
<!-- ホーム画面に追加したときの名前（iPhone）と、アプリとしての情報（Android など） -->
<meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
<link rel="manifest" href="/site.webmanifest?v=4" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />
<!-- スマホのブラウザの上部バーの色（ライト／ダーク） -->
<meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#211f1d" media="(prefers-color-scheme: dark)" />

<!--
  Web フォント
  ・定義は /fonts.css にまとめ、ブラウザにキャッシュしてもらう
  ・media="print" で読み込み始め、読み終わったら all に切り替える
    → フォントの読み込みを待たずに、標準フォントで先に文字を表示できる
  ・日本語フォントは文字ごとに分割されていて、ページで使う文字の分だけ読み込まれる
-->
<link
	rel="stylesheet"
	href={`/fonts.css?v=${fontCssVersion}`}
	media="print"
	onload="this.media='all'"
/>
<noscript><link rel="stylesheet" href={`/fonts.css?v=${fontCssVersion}`} /></noscript>

<!-- 正規 URL -->
<link rel="canonical" href={canonicalURL} />

<!-- ページのタイトルと説明 -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR_NAME} />

<!-- SNS でシェアされたときの表示（Open Graph） -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:locale" content="ja_JP" />
<meta name="twitter:card" content="summary_large_image" />

<!--
  アクセス解析（Google Analytics 4）
  ・測定 ID はページのソースに出る公開情報なので、そのまま書いています
  ・import.meta.env.PROD で本番ビルドのときだけ出力する（npm run dev では計測しない）
  ・このサイトは View Transitions でページを移動するので、読み込みは最初の1回だけ。
    そのままだと2ページ目以降が数えられないため、自動のページビュー送信は切って、
    astro:page-load（初回表示とページ遷移のたびに起きる）で自分で送っています
-->
{
	import.meta.env.PROD && (
		<Fragment>
			<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
			<script is:inline set:html={gaScript} />
		</Fragment>
	)
}
