---
/*
  湯気の立つコーヒーカップ（フッターの飾り）
  湯気はゆっくり立ちのぼって消える動きを繰り返します。
  本文から離れたフッターにだけ置き、「動きを減らす」設定では止まります。
*/
---

<svg class="coffee" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" focusable="false">
	<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<!-- 湯気（3本、少しずつタイミングをずらす） -->
		<path class="coffee__steam" d="M17 18c-2-2.5 2-4.5 0-7.5"></path>
		<path class="coffee__steam" d="M24 18c-2-2.5 2-4.5 0-7.5"></path>
		<path class="coffee__steam" d="M31 18c-2-2.5 2-4.5 0-7.5"></path>
		<!-- カップとソーサー -->
		<path d="M10 22h28v6a10 10 0 0 1-10 10h-8a10 10 0 0 1-10-10z"></path>
		<path d="M38 25h2a4 4 0 0 1 0 8h-2.5"></path>
		<path d="M8 42h32"></path>
	</g>
</svg>

<style>
	.coffee {
		color: var(--c-text-sub);
	}
	.coffee__steam {
		opacity: 0;
		animation: steam 6s var(--ease-inout) infinite;
	}
	.coffee__steam:nth-child(2) {
		animation-delay: 2s;
	}
	.coffee__steam:nth-child(3) {
		animation-delay: 4s;
	}
	/* 下から上へ、ふわっと現れて消える */
	@keyframes steam {
		0% {
			opacity: 0;
			transform: translateY(4px);
		}
		35% {
			opacity: 0.5;
		}
		70%,
		100% {
			opacity: 0;
			transform: translateY(-5px);
		}
	}
	/* 動きを減らす設定のときは、湯気を止めて薄く表示 */
	@media (prefers-reduced-motion: reduce) {
		.coffee__steam {
			animation: none;
			opacity: 0.4;
		}
	}
</style>
