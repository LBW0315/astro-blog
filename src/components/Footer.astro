---
// サイト下部のフッター
import { NAV_LINKS, SITE_MOTTO, SITE_SUBTITLE_EN, SITE_SUBTITLE_JA, SITE_TITLE } from '../consts';
import CoffeeSteam from './CoffeeSteam.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" transition:name="site-footer" transition:animate="none">
	<div class="container site-footer__inner">
		<div class="site-footer__brand">
			<CoffeeSteam />
			<div>
				<p class="site-footer__title">{SITE_TITLE}</p>
				<p class="site-footer__sub-en">{SITE_SUBTITLE_EN}</p>
				<p class="site-footer__sub-ja">{SITE_SUBTITLE_JA}</p>
				<p class="site-footer__motto">{SITE_MOTTO}</p>
			</div>
		</div>

		<nav aria-label="フッターメニュー">
			<ul class="site-footer__links">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
				<li>
					<a href="/rss.xml">
						<Icon name="rss" size={16} />
						RSS
					</a>
				</li>
			</ul>
		</nav>

		<p class="site-footer__copy"><small>&copy; {year} {SITE_TITLE}</small></p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--sp-10);
		border-top: 1px solid var(--c-line);
		background: var(--c-surface);
	}
	.site-footer__inner {
		display: grid;
		gap: var(--sp-5);
		padding-block: var(--sp-8) var(--sp-9);
	}
	.site-footer__brand {
		display: flex;
		align-items: center;
		gap: var(--sp-3);
	}
	.site-footer__title {
		color: var(--c-heading);
		font-family: var(--font-logo);
		font-size: 1.125rem;
		font-weight: var(--fw-logo);
		letter-spacing: var(--ls-logo);
		line-height: 1.4;
	}
	.site-footer__sub-en {
		color: var(--c-text-sub);
		font-family: var(--font-logo);
		font-size: var(--fs-subtitle-en);
		letter-spacing: 0.14em;
		line-height: 1.5;
	}
	.site-footer__sub-ja {
		color: var(--c-text-faint);
		font-size: var(--fs-xs);
		line-height: 1.6;
	}
	/* 一言：淡いグレーで小さく。フッター背景とのコントラスト比 4.66:1（ダーク 4.84:1） */
	.site-footer__motto {
		margin-top: var(--sp-2);
		color: var(--c-text-faint);
		font-family: var(--font-logo);
		font-size: var(--fs-xs);
		letter-spacing: 0.06em;
		line-height: 1.6;
	}
	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		margin: 0 calc(var(--sp-3) * -1);
		padding: 0;
		list-style: none;
	}
	.site-footer__links a {
		display: inline-flex;
		align-items: center;
		gap: var(--sp-1);
		min-height: var(--tap);
		padding-inline: var(--sp-3);
		font-size: var(--fs-sm);
	}
	.site-footer__copy {
		color: var(--c-text-sub);
		font-size: var(--fs-sm);
	}
	@media (min-width: 720px) {
		.site-footer__inner {
			grid-template-columns: 1fr auto;
			align-items: center;
		}
		.site-footer__copy {
			grid-column: 1 / -1;
		}
	}
</style>
