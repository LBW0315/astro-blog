---
// サイト下部のフッター
import { NAV_LINKS, SITE_TAGLINE, SITE_TITLE } from '../consts';
import CoffeeSteam from './CoffeeSteam.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" transition:name="site-footer" transition:animate="none">
	<div class="container site-footer__inner">
		<div class="site-footer__brand">
			<CoffeeSteam />
			<div>
				<p class="site-footer__title">{SITE_TITLE}</p>
				<p class="site-footer__tagline">{SITE_TAGLINE}</p>
			</div>
		</div>

		<nav aria-label="フッターメニュー">
			<ul class="site-footer__links">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
				<li>
					<a href="/rss.xml">
						<Icon name="rss" size={16} />
						RSS
					</a>
				</li>
			</ul>
		</nav>

		<p class="site-footer__copy"><small>&copy; {year} {SITE_TITLE}</small></p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--sp-10);
		border-top: 1px solid var(--c-line);
		background: var(--c-surface);
	}
	.site-footer__inner {
		display: grid;
		gap: var(--sp-5);
		padding-block: var(--sp-8) var(--sp-9);
	}
	.site-footer__brand {
		display: flex;
		align-items: center;
		gap: var(--sp-3);
	}
	.site-footer__title {
		font-family: var(--font-heading);
		font-weight: 700;
		color: var(--c-heading);
		line-height: 1.5;
	}
	.site-footer__tagline {
		color: var(--c-text-sub);
		font-size: var(--fs-sm);
		line-height: 1.5;
	}
	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		margin: 0 calc(var(--sp-3) * -1);
		padding: 0;
		list-style: none;
	}
	.site-footer__links a {
		display: inline-flex;
		align-items: center;
		gap: var(--sp-1);
		min-height: var(--tap);
		padding-inline: var(--sp-3);
		font-size: var(--fs-sm);
	}
	.site-footer__copy {
		color: var(--c-text-sub);
		font-size: var(--fs-sm);
	}
	@media (min-width: 720px) {
		.site-footer__inner {
			grid-template-columns: 1fr auto;
			align-items: center;
		}
		.site-footer__copy {
			grid-column: 1 / -1;
		}
	}
</style>
