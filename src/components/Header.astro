---
// サイト上部のヘッダー
import { NAV_LINKS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header" transition:name="site-header" transition:animate="none">
	<div class="container site-header__inner">
		<a href="/" class="logo">
			<!-- ロゴマーク：万年筆のペン先 -->
			<span class="logo__mark" aria-hidden="true"><Icon name="pen" size={18} /></span>
			<span class="logo__text">{SITE_TITLE}</span>
		</a>

		<ThemeToggle />

		<nav class="site-nav" aria-label="メインメニュー">
			<ul>
				{
					NAV_LINKS.map((link) => (
						<li>
							<HeaderLink href={link.href}>{link.label}</HeaderLink>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--c-line);
		background: var(--c-surface-raised);
	}
	/*
	  スマホ：1段目にロゴと切替ボタン、2段目にメニュー
	  広い画面：1段にまとめる
	*/
	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'logo toggle'
			'nav nav';
		align-items: center;
		column-gap: var(--sp-2);
		padding-block: var(--sp-2);
	}

	.logo {
		grid-area: logo;
		display: inline-flex;
		align-items: center;
		gap: var(--sp-2);
		justify-self: start;
		min-height: var(--tap);
		color: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 1.1875rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
	}
	.logo:hover {
		color: var(--c-heading);
	}
	/* ロゴマーク：丸の中にペン先。ホバーで少し傾く */
	.logo__mark {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: var(--radius-pill);
		background: var(--c-accent-wash);
		color: var(--c-accent);
		transition: transform var(--dur-slow) var(--ease-soft);
	}
	.logo:hover .logo__mark {
		transform: rotate(-12deg);
	}

	:global(.theme-toggle) {
		grid-area: toggle;
	}

	.site-nav {
		grid-area: nav;
		/* メニューが入りきらないときは横にスクロールできる */
		overflow-x: auto;
		margin-inline: calc(var(--sp-3) * -1);
		scrollbar-width: none;
	}
	.site-nav ul {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 720px) {
		.site-header__inner {
			grid-template-columns: auto 1fr auto;
			grid-template-areas: 'logo nav toggle';
			column-gap: var(--sp-5);
			padding-block: var(--sp-3);
		}
		.site-nav {
			justify-self: end;
			margin-inline: 0;
		}
	}
</style>
