---
// サイト上部のヘッダー
import { NAV_LINKS, SITE_SUBTITLE_EN, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header" transition:name="site-header" transition:animate="none">
	<div class="container site-header__inner">
		<!-- ロゴ：サイト名と英語のサブタイトル -->
		<a href="/" class="logo">
			<span class="logo__name">{SITE_TITLE}</span>
			<span class="logo__sub">{SITE_SUBTITLE_EN}</span>
		</a>

		<ThemeToggle />

		<nav class="site-nav" aria-label="メインメニュー">
			<ul>
				{
					NAV_LINKS.map((link) => (
						<li>
							<HeaderLink href={link.href}>{link.label}</HeaderLink>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--c-line);
		background: var(--c-surface-raised);
	}
	/*
	  スマホ：1段目にロゴと切替ボタン、2段目にメニュー
	  広い画面：1段にまとめる
	*/
	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'logo toggle'
			'nav nav';
		align-items: center;
		column-gap: var(--sp-2);
		padding-block: var(--sp-2);
	}

	.logo {
		grid-area: logo;
		display: inline-flex;
		flex-direction: column;
		justify-content: center;
		justify-self: start;
		min-height: var(--tap);
		padding-block: var(--sp-1);
		color: var(--c-heading);
		text-decoration: none;
	}
	.logo:hover {
		color: var(--c-heading);
	}
	/* サイト名：細めの英字を、字間を広くとって */
	.logo__name {
		font-family: var(--font-logo);
		font-size: 1.375rem;
		font-weight: var(--fw-logo);
		line-height: 1.2;
		letter-spacing: var(--ls-logo);
		/* 最後の文字の後ろにも字間が付くので、その分だけ詰める */
		margin-right: calc(var(--ls-logo) * -1);
	}
	/* 英語サブタイトル：小さめに */
	.logo__sub {
		margin-top: 2px;
		color: var(--c-text-sub);
		font-family: var(--font-logo);
		font-size: var(--fs-subtitle-en);
		line-height: 1.3;
		letter-spacing: 0.14em;
		transition: color var(--dur-fast) var(--ease-soft);
	}
	.logo:hover .logo__sub {
		color: var(--c-accent);
	}

	:global(.theme-toggle) {
		grid-area: toggle;
	}

	.site-nav {
		grid-area: nav;
		/* メニューが入りきらないときは横にスクロールできる */
		overflow-x: auto;
		margin-inline: calc(var(--sp-3) * -1);
		scrollbar-width: none;
	}
	.site-nav ul {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 720px) {
		.site-header__inner {
			grid-template-columns: auto 1fr auto;
			grid-template-areas: 'logo nav toggle';
			column-gap: var(--sp-5);
			padding-block: var(--sp-3);
		}
		.site-nav {
			justify-self: end;
			margin-inline: 0;
		}
	}
</style>
