---
// 書き手の簡単な紹介（トップページ・記事の最後に表示）
import { AUTHOR_INTRO, AUTHOR_NAME, AUTHOR_ROLE, SITE_TITLE } from '../consts';
import Icon from './Icon.astro';
import Pekingese from './Pekingese.astro';
---

<aside class="profile" aria-labelledby="profile-title" data-reveal>
	<div class="profile__avatar">
		<Pekingese size={72} tilt />
	</div>
	<div class="profile__body">
		<p class="profile__eyebrow">書いている人</p>
		<h2 id="profile-title" class="profile__title">{AUTHOR_NAME}</h2>
		<p class="profile__role">{AUTHOR_ROLE}</p>
		<!-- 紹介文（src/consts.ts の AUTHOR_INTRO。行ごとに改行して表示） -->
		<p class="profile__text">
			{AUTHOR_INTRO.map((line, i) => (i > 0 ? [<br />, line] : line))}
		</p>
		<!-- 最後の一文：一段小さく淡いグレーで、プロフィールページの「BUNBOU について」へ -->
		<p class="profile__about">
			<a href="/about/#about-bunbou">{SITE_TITLE}（文房）は、「書斎」という意味の言葉です。</a>
		</p>
		<a href="/about/" class="pill-link">
			プロフィールを見る
			<Icon name="arrow-right" size={16} />
		</a>
	</div>
</aside>

<style>
	.profile {
		display: grid;
		gap: var(--sp-4);
		padding: var(--sp-5);
		border: 1px solid var(--c-line);
		border-radius: var(--radius-lg);
		background: var(--c-surface-raised);
	}
	.profile__avatar {
		display: grid;
		place-items: center;
		width: 104px;
		height: 104px;
		border-radius: var(--radius-pill);
		background: var(--c-accent-wash);
	}
	.profile__body {
		display: grid;
		gap: var(--sp-2);
		justify-items: start;
	}
	.profile__eyebrow {
		color: var(--c-text-sub);
		font-size: var(--fs-sm);
	}
	/* 名前：丸ゴシックで少し大きく */
	.profile__title {
		font-size: var(--fs-h2);
		line-height: 1.3;
	}
	/* 肩書き：名前のすぐ下に小さく */
	.profile__role {
		margin-top: calc(var(--sp-2) * -1);
		color: var(--c-text-sub);
		font-size: var(--fs-sm);
	}
	.profile__text {
		font-size: var(--fs-sm);
		line-height: 1.8;
	}
	/*
	  BUNBOU についての一文：本文（14px）より一段小さい 13px、淡いグレー
	  カード背景とのコントラスト比 5.30:1（ダーク 4.97:1）
	  リンクだとわかるよう、下線は常に表示する
	*/
	.profile__about {
		margin-bottom: var(--sp-2);
		font-size: var(--fs-xs);
		line-height: 1.8;
	}
	.profile__about a {
		color: var(--c-text-faint);
		text-decoration-color: var(--c-line-strong);
	}
	.profile__about a:hover {
		color: var(--c-accent);
		text-decoration-color: currentColor;
	}
	@media (min-width: 640px) {
		.profile {
			grid-template-columns: auto 1fr;
			gap: var(--sp-5);
			padding: var(--sp-6);
		}
	}
</style>
