---
/*
  記事「ブログを始めて1か月。収益0円だけど、とりあえず半年続けてみようと思う。」専用の図解
  初めての振り込みまでの道のり（手描き風）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
  色だけで区別しないように、次の組み合わせにしています。
  - できていること：青磁の実線の枠＋「いまここ」のラベル
  - これからのこと：灰桜の点線の枠＋「これから」のラベル
*/
type Row = { y: number; title: string; sub: string; done?: boolean };

const BOX_X = 44;
const BOX_W = 272;
const BOX_H = 58;
const CX = 180;

const rows: Row[] = [
	{ y: 16, title: '記事を書く', sub: 'この記事で22本目', done: true },
	{ y: 104, title: 'AdSenseの審査に通る', sub: '10月6日に1度落ちた' },
	{ y: 192, title: '収益が8,000円たまる', sub: 'それまでは振り込まれない' },
	{ y: 280, title: '初めての振り込み', sub: 'いつになるのでしょうか' },
];

const arrow = (y1: number, y2: number) => `M${CX} ${y1}q3 ${(y2 - y1) / 2} 0 ${y2 - y1} M${CX - 6} ${y2 - 7}l6 7 6-7`;

const H = 354;
---

<figure class="apr">
	<svg viewBox={`0 0 360 ${H}`} role="img" aria-labelledby="apr-title apr-desc">
		<title id="apr-title">初めての振り込みまでの道のり</title>
		<desc id="apr-desc">
			いまできているのは、記事を書くことだけ。この記事で22本目。これから先に、AdSenseの審査に通る、収益が8,000円たまる、初めての振り込みを受ける、という3つの段階が残っている。審査は10月6日に1度落ちていて、収益は8,000円たまるまで振り込まれない。
		</desc>
		<defs>
			<filter id="adsense-payout-road-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="8"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#adsense-payout-road-sketch)">
			{
				rows.map((r) => (
					<rect
						class:list={['apr-box', r.done ? 'apr-box--done' : 'apr-box--todo']}
						x={BOX_X}
						y={r.y}
						width={BOX_W}
						height={BOX_H}
						rx="10"
					/>
				))
			}
			{rows.slice(0, -1).map((r) => <path class="apr-arrow" d={arrow(r.y + BOX_H + 4, r.y + 84)} />)}
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		{
			rows.map((r) => (
				<g>
					<text class="apr-title" x={BOX_X + 18} y={r.y + 25}>
						{r.title}
					</text>
					<text class="apr-sub" x={BOX_X + 18} y={r.y + 46}>
						{r.sub}
					</text>
				</g>
			))
		}

		<!-- 「いまここ」ラベル -->
		<g class="apr-tag apr-tag--now">
			<rect x="244" y={rows[0].y - 11} width="80" height="24" rx="12"></rect>
			<text x="284" y={rows[0].y + 1} text-anchor="middle" dominant-baseline="central">いまここ</text>
		</g>
		<!-- 「これから」ラベル -->
		<g class="apr-tag apr-tag--todo">
			<rect x="244" y={rows[1].y - 11} width="80" height="24" rx="12"></rect>
			<text x="284" y={rows[1].y + 1} text-anchor="middle" dominant-baseline="central">これから</text>
		</g>
	</svg>
	<figcaption>初めての振り込みまでの道のり（実線の枠はできていること、点線の枠はこれからのこと）</figcaption>
</figure>

<style>
	.apr svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.apr-box {
		stroke-width: 2;
	}
	.apr-box--done {
		fill: var(--c-accent-wash);
		stroke: var(--c-accent);
	}
	.apr-box--todo {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent2);
		stroke-dasharray: 8 6;
	}
	.apr-arrow {
		fill: none;
		stroke: var(--c-line-strong);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.apr-title {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
	.apr-sub {
		fill: var(--c-text-sub);
		font-size: 14px;
	}
	.apr-tag rect {
		fill: var(--c-surface-raised);
		stroke-width: 1.2;
	}
	.apr-tag text {
		font-size: 14px;
		font-weight: 700;
	}
	.apr-tag--now rect {
		stroke: var(--c-accent);
	}
	.apr-tag--now text {
		fill: var(--c-accent);
	}
	.apr-tag--todo rect {
		stroke: var(--c-accent2);
	}
	.apr-tag--todo text {
		fill: var(--c-accent2);
	}
</style>
