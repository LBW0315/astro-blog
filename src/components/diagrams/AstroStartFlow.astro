---
/*
  記事「AIに聞きながら、Astroでブログを作り始めた日」専用の図解
  コマンドを入力してから、ブラウザに最初の画面が表示されるまでの流れ。
*/
type Step = { y: number; number: string; title: string; sub: string; icon: string };

const steps: Step[] = [
	{ y: 34, number: '1', title: 'コマンドを入力', sub: 'npm create astro@latest', icon: 'terminal' },
	{ y: 128, number: '2', title: '質問に答える', sub: 'ブログのテンプレートを選択', icon: 'question' },
	{ y: 222, number: '3', title: 'プロジェクト完成', sub: '必要なファイルがそろう', icon: 'folder' },
	{ y: 316, number: '4', title: 'ブラウザで確認', sub: '最初の画面が表示された', icon: 'browser' },
];

const ICONS: Record<string, string> = {
	terminal: 'M2 4h24v20H2z M6 10l4 4-4 4 M13 18h7',
	question: 'M7 8a7 7 0 0 1 14 0c0 5-7 5-7 10 M14 24v.5 M3 3h3 M22 3h3',
	folder: 'M2 7h9l3 4h12v14H2z M2 11h24 M8 18h12',
	browser: 'M2 4h24v20H2z M2 10h24 M6 7h.5 M10 7h.5 M8 15h12 M8 19h8',
};

const arrow = (from: number, to: number) =>
	`M180 ${from}q4 ${(to - from) / 2} 0 ${to - from} M174 ${to - 7}l6 7 6-7`;
---

<figure class="asf">
	<svg viewBox="0 0 360 404" role="img" aria-labelledby="asf-title asf-desc">
		<title id="asf-title">Astroのプロジェクトを作り、最初の画面を見るまで</title>
		<desc id="asf-desc">
			npm create astro@latestを入力し、セットアップの質問でブログテンプレートを選び、プロジェクトを作成して、ブラウザで最初の画面を確認する4段階の流れ。
		</desc>
		<defs>
			<filter id="astro-start-flow-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="12"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<g filter="url(#astro-start-flow-sketch)">
			<!-- ノートの綴じ穴 -->
			<path class="asf__paper" d="M18 12h324v380H18z" />
			<path class="asf__margin" d="M54 12v380" />
			{[52, 126, 200, 274, 348].map((y) => <circle class="asf__hole" cx="34" cy={y} r="5" />)}

			{
				steps.map((step) => (
					<g>
						<rect class="asf__box" x="70" y={step.y} width="256" height="64" rx="12" />
						<circle class="asf__number-disc" cx="70" cy={step.y + 32} r="18" />
						<path class="asf__icon" transform={`translate(88 ${step.y + 18})`} d={ICONS[step.icon]} />
					</g>
				))
			}
			<path class="asf__arrow" d={arrow(102, 124)} />
			<path class="asf__arrow" d={arrow(196, 218)} />
			<path class="asf__arrow" d={arrow(290, 312)} />
		</g>

		{
			steps.map((step) => (
				<g>
					<text class="asf__number" x="70" y={step.y + 33} text-anchor="middle" dominant-baseline="central">
						{step.number}
					</text>
					<text class="asf__title" x="128" y={step.y + 27}>{step.title}</text>
					<text class="asf__sub" x="128" y={step.y + 48}>{step.sub}</text>
				</g>
			))
		}
	</svg>
	<figcaption>コマンドを入力してから、最初の画面が表示されるまで</figcaption>
</figure>

<style>
	.asf svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.asf__paper {
		fill: var(--c-surface-raised);
		stroke: var(--c-line-strong);
		stroke-width: 1.2;
	}
	.asf__margin {
		fill: none;
		stroke: var(--c-accent2);
		stroke-width: 1.3;
		stroke-dasharray: 5 5;
	}
	.asf__hole {
		fill: var(--c-bg);
		stroke: var(--c-line-strong);
		stroke-width: 1.2;
	}
	.asf__box {
		fill: var(--c-bg);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.asf__number-disc {
		fill: var(--c-accent-wash);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.asf__icon,
	.asf__arrow {
		fill: none;
		stroke: var(--c-text);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.asf__arrow {
		stroke: var(--c-line-strong);
		stroke-width: 2.2;
	}
	.asf__number {
		fill: var(--c-accent);
		font-family: var(--font-heading);
		font-size: 16px;
		font-weight: 700;
	}
	.asf__title {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
	.asf__sub {
		fill: var(--c-text-sub);
		font-size: 15px;
	}
</style>
