---
/*
  記事「私たちがNATUR-sagaを選んだ理由。最後の決め手は「人」だった！ ― 家づくり記録④」専用の図解
  妻と私の決め手が、同じ1社に集まる（手描き風）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
  色だけで区別しないように、箱の上に「妻」「私」と書いています。
  - 妻と私が魅力を感じたところ：灰色の線の箱
  - 2人とも納得して選んだ会社：青磁で塗った箱
  - 集まる向き：灰桜の矢印
*/
type Side = { x: number; who: string; items: string[] };

const BOX_W = 170;
const sides: Side[] = [
	{ x: 4, who: '妻', items: ['営業担当の方の人柄', '建物のデザイン', '内装のセンス'] },
	{ x: 186, who: '私', items: ['会社としての実績', '地域密着の姿勢', '性能と価格のバランス'] },
];
---

<figure class="crc">
	<svg viewBox="0 0 360 300" role="img" aria-labelledby="crc-title crc-desc">
		<title id="crc-title">妻と私の決め手が、同じ1社に集まる</title>
		<desc id="crc-desc">
			左は妻が魅力を感じたところで、営業担当の方の人柄、建物のデザイン、内装のセンス。右は私が魅力を感じたところで、会社としての実績、地域密着の姿勢、性能と価格のバランス。見ていたところは違っても、2人の矢印は同じナチュールサガさんに集まり、夫婦それぞれが納得できた。
		</desc>
		<defs>
			<filter id="couple-reasons-converge-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="77"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#couple-reasons-converge-sketch)">
			{sides.map((s) => <rect class="crc-box" x={s.x} y="38" width={BOX_W} height="98" rx="12" />)}
			<!-- 集まる矢印 -->
			<path class="crc-arrow" d="M100 142Q112 186 150 206m-14 2l14 -2 -6 -13"></path>
			<path class="crc-arrow" d="M260 142Q248 186 210 206m14 2l-14 -2 6 -13"></path>
			<!-- 選んだ会社 -->
			<rect class="crc-pick" x="76" y="214" width="208" height="50" rx="12"></rect>
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		{
			sides.map((s) => (
				<g>
					<text class="crc-who" x={s.x + BOX_W / 2} y="26" text-anchor="middle">
						{s.who}
					</text>
					{s.items.map((t, i) => (
						<text class="crc-item" x={s.x + BOX_W / 2} y={66 + i * 26} text-anchor="middle">
							{t}
						</text>
					))}
				</g>
			))
		}
		<text class="crc-pick-text" x="180" y="244" text-anchor="middle">ナチュールサガさん</text>
		<text class="crc-note" x="180" y="290" text-anchor="middle">夫婦それぞれが納得できた</text>
	</svg>
	<figcaption>見ていたところは違っても、妻と私の決め手は同じ会社に集まった</figcaption>
</figure>

<style>
	.crc svg {
		display: block;
		width: 100%;
		max-width: 28rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.crc-box {
		fill: var(--c-surface);
		stroke: var(--c-line-strong);
		stroke-width: 2;
	}
	.crc-pick {
		fill: var(--c-accent);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.crc-arrow {
		fill: none;
		stroke: var(--c-accent2);
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.crc-who {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
	.crc-item {
		fill: var(--c-text);
		font-size: 15px;
	}
	.crc-pick-text {
		fill: var(--c-on-accent);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
	.crc-note {
		fill: var(--c-accent);
		font-size: 15px;
		font-weight: 700;
	}
</style>
