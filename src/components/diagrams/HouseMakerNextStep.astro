---
/*
  記事「ハウスメーカーを調べ尽くした結果、余計に決められなくなった話 ― 家づくり記録②」専用の図解
  家を建てると決めてから、次の段階に進むまでの流れ（手描き風）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
  色だけで区別しないように、次の組み合わせにしています。
  - この記事で書いたところ：青磁の実線と塗りつぶした丸
  - 次回の記事で書くところ：灰桜の点線と白抜きの丸＋「次回」のラベル
*/
type Stop = { y: number; sub: string; title: string; done?: boolean };

const LINE_X = 40;
const TEXT_X = 66;

const stops: Stop[] = [
	{ y: 38, sub: '前回', title: '家を建てると決める', done: true },
	{ y: 108, sub: 'YouTubeを中心に', title: 'ハウスメーカーを調べる', done: true },
	{ y: 178, sub: 'その結果', title: '調べるほど決められない', done: true },
	{ y: 248, sub: '気になっていたのは', title: 'セキスイハイムと大和ハウス', done: true },
	{ y: 318, sub: '次の段階', title: 'ハウスメーカーと接点を持つ' },
];

const LAST_DONE_Y = stops.filter((s) => s.done).at(-1)!.y;
const END_Y = stops[stops.length - 1].y;
const H = 352;
---

<figure class="hmn">
	<svg viewBox={`0 0 360 ${H}`} role="img" aria-labelledby="hmn-title hmn-desc">
		<title id="hmn-title">家を建てると決めてから、次の段階に進むまでの流れ</title>
		<desc id="hmn-desc">
			前回の記事で、家を建てると決めた。次に、YouTubeを中心にハウスメーカーを調べた。その結果、調べるほど決められなくなった。それでも、気になっていたのはセキスイハイムと大和ハウス。次の段階は、実際にハウスメーカーと接点を持つこと。ここは次回の記事で書く。
		</desc>
		<defs>
			<filter id="house-maker-next-step-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="41"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#house-maker-next-step-sketch)">
			<!-- この記事で書いたところ（青磁の実線） -->
			<path class="hmn-done" d={`M${LINE_X} ${stops[0].y}q3 ${(LAST_DONE_Y - stops[0].y) / 2} 0 ${LAST_DONE_Y - stops[0].y}`}></path>
			<!-- 次回の記事で書くところ（灰桜の点線） -->
			<path class="hmn-todo" d={`M${LINE_X} ${LAST_DONE_Y}q-3 ${(END_Y - LAST_DONE_Y) / 2} 0 ${END_Y - LAST_DONE_Y}`}></path>
			{
				stops.map((s) =>
					s.done ? (
						<circle class="hmn-dot hmn-dot--done" cx={LINE_X} cy={s.y} r="8" />
					) : (
						<circle class="hmn-dot hmn-dot--todo" cx={LINE_X} cy={s.y} r="8" />
					),
				)
			}
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		{
			stops.map((s) => (
				<g>
					<text class="hmn-sub" x={TEXT_X} y={s.y - 8}>
						{s.sub}
					</text>
					<text class:list={['hmn-title', { 'hmn-title--todo': !s.done }]} x={TEXT_X} y={s.y + 14}>
						{s.title}
					</text>
				</g>
			))
		}

		<!-- 「次回」ラベル -->
		<g class="hmn-tag">
			<rect x="272" y={END_Y - 26} width="64" height="24" rx="12"></rect>
			<text x="304" y={END_Y - 14} text-anchor="middle" dominant-baseline="central">次回</text>
		</g>
	</svg>
	<figcaption>家を建てると決めてから、次の段階に進むまで（実線はこの記事で書いたところ、点線は次回の記事で書くところ）</figcaption>
</figure>

<style>
	.hmn svg {
		display: block;
		width: 100%;
		max-width: 28rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.hmn-done,
	.hmn-todo {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 3;
	}
	.hmn-done {
		stroke: var(--c-accent);
	}
	.hmn-todo {
		stroke: var(--c-accent2);
		stroke-dasharray: 8 6;
	}
	.hmn-dot--done {
		fill: var(--c-accent);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.hmn-dot--todo {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent2);
		stroke-width: 2;
		stroke-dasharray: 4 3;
	}
	.hmn-sub {
		fill: var(--c-text-sub);
		font-size: 15px;
	}
	.hmn-title {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
	.hmn-title--todo {
		fill: var(--c-text);
	}
	.hmn-tag rect {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent2);
		stroke-width: 1.2;
	}
	.hmn-tag text {
		fill: var(--c-accent2);
		font-size: 15px;
		font-weight: 700;
	}
</style>
