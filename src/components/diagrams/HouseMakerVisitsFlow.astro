---
/*
  記事「ネットで調べるだけでは分からなかった。夫婦でハウスメーカーを巡って感じたこと ― 家づくり記録③」専用の図解
  ハウスメーカーを見学して回った順番と、次の段階（手描き風）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
  色だけで区別しないように、次の組み合わせにしています。
  - この記事で書いたところ：青磁の実線と塗りつぶした丸
  - 次回の記事で書くところ：灰桜の点線と白抜きの丸＋「次回」のラベル
*/
type Stop = { y: number; sub: string; title: string; done?: boolean };

const LINE_X = 40;
const TEXT_X = 66;

const stops: Stop[] = [
	{ y: 38, sub: '前回', title: 'ネットで調べ尽くす', done: true },
	{ y: 108, sub: '全館空調に魅力を感じる', title: 'セキスイハイム', done: true },
	{ y: 178, sub: '平屋で、木の香りを感じた', title: '住友林業', done: true },
	{ y: 248, sub: '土地の話と、すごい木の香り', title: '地元の会社・工務店', done: true },
	{ y: 318, sub: '月々の支払いに驚く', title: 'タマホーム', done: true },
	{ y: 388, sub: '次の段階', title: '1社に決める' },
];

const LAST_DONE_Y = stops.filter((s) => s.done).at(-1)!.y;
const END_Y = stops[stops.length - 1].y;
const H = 422;
---

<figure class="hmv">
	<svg viewBox={`0 0 360 ${H}`} role="img" aria-labelledby="hmv-title hmv-desc">
		<title id="hmv-title">ハウスメーカーを見学して回った順番と、次の段階</title>
		<desc id="hmv-desc">
			前回の記事で、ネットでハウスメーカーを調べ尽くした。そのあと見学した順に、セキスイハイム（全館空調に魅力を感じる）、住友林業（平屋で、木の香りを感じた）、地元の会社・工務店（土地の話と、すごい木の香り）、タマホーム（月々の支払いに驚く）。次の段階は、1社に決めること。ここは次回の記事で書く。
		</desc>
		<defs>
			<filter id="house-maker-visits-flow-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="47"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#house-maker-visits-flow-sketch)">
			<!-- この記事で書いたところ（青磁の実線） -->
			<path class="hmv-done" d={`M${LINE_X} ${stops[0].y}q3 ${(LAST_DONE_Y - stops[0].y) / 2} 0 ${LAST_DONE_Y - stops[0].y}`}></path>
			<!-- 次回の記事で書くところ（灰桜の点線） -->
			<path class="hmv-todo" d={`M${LINE_X} ${LAST_DONE_Y}q-3 ${(END_Y - LAST_DONE_Y) / 2} 0 ${END_Y - LAST_DONE_Y}`}></path>
			{
				stops.map((s) =>
					s.done ? (
						<circle class="hmv-dot hmv-dot--done" cx={LINE_X} cy={s.y} r="8" />
					) : (
						<circle class="hmv-dot hmv-dot--todo" cx={LINE_X} cy={s.y} r="8" />
					),
				)
			}
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		{
			stops.map((s) => (
				<g>
					<text class="hmv-sub" x={TEXT_X} y={s.y - 8}>
						{s.sub}
					</text>
					<text class:list={['hmv-title', { 'hmv-title--todo': !s.done }]} x={TEXT_X} y={s.y + 14}>
						{s.title}
					</text>
				</g>
			))
		}

		<!-- 「次回」ラベル -->
		<g class="hmv-tag">
			<rect x="272" y={END_Y - 26} width="64" height="24" rx="12"></rect>
			<text x="304" y={END_Y - 14} text-anchor="middle" dominant-baseline="central">次回</text>
		</g>
	</svg>
	<figcaption>見学して回った順番と、次の段階（実線はこの記事で書いたところ、点線は次回の記事で書くところ）</figcaption>
</figure>

<style>
	.hmv svg {
		display: block;
		width: 100%;
		max-width: 28rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.hmv-done,
	.hmv-todo {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 3;
	}
	.hmv-done {
		stroke: var(--c-accent);
	}
	.hmv-todo {
		stroke: var(--c-accent2);
		stroke-dasharray: 8 6;
	}
	.hmv-dot--done {
		fill: var(--c-accent);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.hmv-dot--todo {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent2);
		stroke-width: 2;
		stroke-dasharray: 4 3;
	}
	.hmv-sub {
		fill: var(--c-text-sub);
		font-size: 15px;
	}
	.hmv-title {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
	.hmv-title--todo {
		fill: var(--c-text);
	}
	.hmv-tag rect {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent2);
		stroke-width: 1.2;
	}
	.hmv-tag text {
		fill: var(--c-accent2);
		font-size: 15px;
		font-weight: 700;
	}
</style>
