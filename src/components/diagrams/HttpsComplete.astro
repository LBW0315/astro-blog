---
/*
  記事「独自ドメインでHTTPSになるまで」専用の図解
  完成した構成（手描き風）

  前の記事では点線＝「これから」だった Route 53 と ACM が、
  この記事で全部つながったので、すべて青磁の実線で描いています。

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
*/
type Row = { y: number; title: string; sub: string; icon: string };

const BOX_X = 40;
const BOX_W = 280;
const BOX_H = 56;
const CX = 180; // 矢印の横位置

const rows: Row[] = [
	{ y: 14, title: 'ブラウザ', sub: 'https://bun-bou.com', icon: 'browser' },
	{ y: 102, title: 'Route 53', sub: 'Aレコード（エイリアス）', icon: 'globe' },
	{ y: 190, title: 'CloudFront', sub: '証明書つきでHTTPS配信', icon: 'cloud' },
	{ y: 278, title: 'S3', sub: '記事のHTMLを置く場所', icon: 'bucket' },
];

// アイコン（28×28 のマス目の手描き線）
const ICONS: Record<string, string> = {
	browser: 'M1 3h26v22H1z M1 9h26 M5 6h.5 M9 6h.5',
	globe: 'M14 2a12 12 0 1 0 0 24a12 12 0 1 0 0-24z M14 2c-7 7-7 17 0 24 M14 2c7 7 7 17 0 24 M2 14h24',
	cloud: 'M7 22h15a5 5 0 0 0 0-10a7 7 0 0 0-13-2a6 6 0 0 0-2 12z',
	bucket: 'M3 7l3 18h16l3-18 M3 7c0 4 22 4 22 0c0-4-22-4-22 0z',
};

const arrow = (y1: number, y2: number) => `M${CX} ${y1}q3 ${(y2 - y1) / 2} 0 ${y2 - y1} M${CX - 6} ${y2 - 7}l6 7 6-7`;

const H = 346;
---

<figure class="https-complete">
	<svg viewBox={`0 0 360 ${H}`} role="img" aria-labelledby="https-complete-title https-complete-desc">
		<title id="https-complete-title">独自ドメインでHTTPSになった構成</title>
		<desc id="https-complete-desc">
			ブラウザで https://bun-bou.com を開くと、Route 53 のAレコード（エイリアス）がCloudFrontを指し、CloudFrontがACMの証明書つきでHTTPS配信する。記事のHTMLはS3に置いてある。すべて動いている状態。
		</desc>
		<defs>
			<filter id="https-complete-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="31"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#https-complete-sketch)">
			{
				rows.map((r) => (
					<g class="hc-box">
						<rect x={BOX_X} y={r.y} width={BOX_W} height={BOX_H} rx="10" />
						<path class="hc-icon" transform={`translate(${BOX_X + 14} ${r.y + 14})`} d={ICONS[r.icon]} />
					</g>
				))
			}
			<path class="hc-arrow" d={arrow(70, 98)} />
			<path class="hc-arrow" d={arrow(158, 186)} />
			<path class="hc-arrow" d={arrow(246, 274)} />

			<!-- 鍵（証明書でHTTPSになっている印） -->
			<path class="hc-icon hc-icon--key" transform="translate(286 204)" d="M1 12h18v14H1z M5 12V8a5 5 0 0 1 10 0v4" />
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		{
			rows.map((r) => (
				<g>
					<text class="hc-title" x={BOX_X + 56} y={r.y + 24}>
						{r.title}
					</text>
					<text class="hc-sub" x={BOX_X + 56} y={r.y + 44}>
						{r.sub}
					</text>
				</g>
			))
		}
	</svg>
	<figcaption>完成した構成。前の記事で点線だった部分が、全部つながりました</figcaption>
</figure>

<style>
	.https-complete svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.hc-box rect {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.hc-icon,
	.hc-arrow {
		fill: none;
		stroke: var(--c-text);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.hc-arrow {
		stroke: var(--c-line-strong);
		stroke-width: 2.2;
	}
	.hc-icon--key {
		stroke: var(--c-accent);
	}
	.hc-title {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 16px;
		font-weight: 700;
	}
	.hc-sub {
		fill: var(--c-text-sub);
		font-size: 14px;
	}
</style>
