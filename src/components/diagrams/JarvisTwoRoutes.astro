---
/*
  記事「無料枠でジャーヴィスっぽくAIを使ってみた！」専用の図解
  ジャーヴィスを自作する道と、ChatGPTの音声モードのボタンを押すだけの道の対比（手描き風）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。

  色だけで区別しないように、次の組み合わせにしています。
  - 自作の道：グレーの実線＋「私にはハードルが高い」の文字
  - ボタンを押すだけ：青磁の実線
*/
type Chip = { x: number; y: number; text: string };

const CHIP_W = 92;
const CHIP_H = 34;

const chips: Chip[] = [
	{ x: 36, y: 40, text: 'API' },
	{ x: 134, y: 40, text: 'Python' },
	{ x: 232, y: 40, text: 'サーバー' },
	{ x: 36, y: 82, text: '音声認識' },
	{ x: 134, y: 82, text: '自動化' },
	{ x: 232, y: 82, text: '各種設定' },
];

const H = 316;
---

<figure class="jarvis-routes">
	<svg viewBox={`0 0 360 ${H}`} role="img" aria-labelledby="jarvis-routes-title jarvis-routes-desc">
		<title id="jarvis-routes-title">ジャーヴィスを自作する道と、ボタンを押すだけの道</title>
		<desc id="jarvis-routes-desc">
			ジャーヴィスのようなAIを自作しようとすると、API、Python、サーバー、音声認識、自動化、各種設定が出てきて、私にはハードルが高い。一方、AIと会話するだけなら、ChatGPTの音声モードのボタンを押すだけで、設定もプログラムもいらない。
		</desc>
		<defs>
			<filter id="jarvis-routes-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#jarvis-routes-sketch)">
			<rect class="jr-group" x="20" y="26" width="320" height="130" rx="14"></rect>
			{chips.map((c) => <rect class="jr-chip" x={c.x} y={c.y} width={CHIP_W} height={CHIP_H} rx="8" />)}

			<rect class="jr-now" x="20" y="204" width="320" height="100" rx="14"></rect>
			<circle class="jr-button" cx="80" cy="254" r="30"></circle>
			<path class="jr-wave" d="M68 248v12 M76 242v24 M84 244v20 M92 249v10"></path>
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		<text class="jr-label" x="20" y="18">ジャーヴィスを自作する</text>
		{
			chips.map((c) => (
				<text class="jr-chip-text" x={c.x + CHIP_W / 2} y={c.y + CHIP_H / 2} text-anchor="middle" dominant-baseline="central">
					{c.text}
				</text>
			))
		}
		<text class="jr-note" x="180" y="140" text-anchor="middle">私にはハードルが高い…</text>

		<text class="jr-label jr-label--now" x="20" y="196">会話するだけなら</text>
		<text class="jr-now-title" x="128" y="248">ボタンを押すだけ</text>
		<text class="jr-now-sub" x="128" y="272">設定もプログラムもいらない</text>
	</svg>
	<figcaption>自作しようとすると難しい言葉が並ぶ。会話するだけなら、ボタン1つ</figcaption>
</figure>

<style>
	.jarvis-routes svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.jr-group {
		fill: var(--c-surface);
		stroke: var(--c-line-strong);
		stroke-width: 2;
	}
	.jr-chip {
		fill: var(--c-surface-raised);
		stroke: var(--c-line-strong);
		stroke-width: 1.6;
	}
	.jr-now {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.jr-button {
		fill: var(--c-accent);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.jr-wave {
		fill: none;
		stroke: var(--c-on-accent);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.jr-label {
		fill: var(--c-text-sub);
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 700;
	}
	.jr-label--now {
		fill: var(--c-accent);
	}
	.jr-chip-text {
		fill: var(--c-text);
		font-size: 14px;
	}
	.jr-note {
		fill: var(--c-text-sub);
		font-size: 14px;
	}
	.jr-now-title {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
	.jr-now-sub {
		fill: var(--c-text-sub);
		font-size: 14px;
	}
</style>
