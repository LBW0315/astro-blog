---
/*
  記事「はたらく！キッズDAYに行ってみようと思う！」専用のイラスト
  体験できる8つのお仕事を、線画のアイコンで並べたもの（手描き風）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
  文字は HTML 側に置いているので、スマホでも小さくならず、読み上げ・コピーもできます。
  色だけで区別しないように、次の組み合わせにしています。
  - ネットで時間を選んで予約できるお仕事：青磁の実線＋「ネット予約」
  - 公式に予約枠の記載がないお仕事：灰桜の点線＋「記載なし」
*/
type Job = { name: string; icon: string; booking: boolean };

const jobs: Job[] = [
	{ name: 'パティシエ', icon: 'cake', booking: true },
	{ name: 'お花屋さん', icon: 'flower', booking: true },
	{ name: '社労士', icon: 'doc', booking: true },
	{ name: '歯科衛生士', icon: 'tooth', booking: true },
	{ name: 'お庭プランナー', icon: 'tree', booking: true },
	{ name: '住宅プランナー', icon: 'house', booking: true },
	{ name: '車屋さん', icon: 'car', booking: false },
	{ name: '家事代行', icon: 'broom', booking: false },
];

// 32×32 のます目に、少ない線で描いたアイコン
const ICONS: Record<string, string> = {
	cake: 'M5 27h22 M8 27V17h16v10 M8 17q4-4.5 8 0q4 4.5 8 0 M16 11v-2 M13 13h6',
	flower: 'M16 29V14 M16 14q-6-1-6-6 M16 14q6-1 6-6 M16 20q-5 0-7-4 M16 20q5 0 7-4 M13 9a3 3 0 1 1 6 0a3 3 0 1 1-6 0',
	doc: 'M8 3h12l5 5v21H8z M20 3v5h5 M12 14h11 M12 19h11 M12 24h5 M22 24a2.5 2.5 0 1 0 0 .01',
	tooth: 'M9 8q7-4 14 0q4 3 2 9l-2 10q-1 3-3 .5l-2-6q-1.5-3-3 0l-2 6q-2 2.5-3-.5L8 17q-2-6 1-9z M13 12q3-1.5 6 0',
	tree: 'M16 27v-7 M16 20q-7-1-7-7.5q0-5.5 7-5.5q7 0 7 5.5q0 6.5-7 7.5 M3 29h26 M5 29q0-4 3-4t3 4 M21 29q0-4 3-4t3 4',
	house: 'M4 15L16 5l12 10 M7 13v15h18V13 M13 28v-8h6v8 M8 20h3',
	car: 'M4 22v-5l3-7h18l3 7v5 M8 10l-1.5 7h19L24 10 M11 22a3 3 0 1 0 0 .01 M24 22a3 3 0 1 0 0 .01 M4 22h24',
	broom: 'M24 4L14 16 M14 16l6 4 M14 16q-6 1-7 7l12 7q4-5 1-10 M11 20l-2 4 M15 22l-1.5 4 M18 24l-1 3',
};
---

<figure class="kd-jobs">
	<!-- 手描き風のゆらぎ（この図の中のアイコンだけに使う） -->
	<svg class="kd-defs" aria-hidden="true" focusable="false">
		<defs>
			<filter id="kidsday-jobs-sketch" x="-8%" y="-8%" width="116%" height="116%">
				<feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="7"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>
	</svg>

	<ul class="kd-grid">
		{
			jobs.map((job) => (
				<li class:list={['kd-card', { 'kd-card--nolink': !job.booking }]}>
					<svg
						class="kd-icon"
						viewBox="0 0 32 32"
						role="img"
						aria-label={`${job.name}のイラスト`}
						focusable="false"
					>
						<path filter="url(#kidsday-jobs-sketch)" d={ICONS[job.icon]} />
					</svg>
					<span class="kd-name">{job.name}</span>
					<span class="kd-badge">{job.booking ? 'ネット予約' : '記載なし'}</span>
				</li>
			))
		}
	</ul>
	<figcaption>
		はたらく！キッズDAYで体験できる8つのお仕事（2026年10月1日時点の公式サイトの情報をもとに作成）。「記載なし」は、公式サイトにネット予約の受付リンクが見当たらないお仕事です。
	</figcaption>
</figure>

<style>
	.kd-defs {
		position: absolute;
		width: 0;
		height: 0;
	}
	.kd-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--sp-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.kd-card {
		display: grid;
		justify-items: center;
		gap: var(--sp-2);
		padding: var(--sp-4) var(--sp-2);
		border: 2px solid var(--c-accent);
		border-radius: var(--radius-md);
		background: var(--c-surface-raised);
		text-align: center;
	}
	.kd-card--nolink {
		border-style: dashed;
		border-color: var(--c-accent2);
	}
	.kd-icon {
		width: 56px;
		height: 56px;
		overflow: visible;
	}
	.kd-icon path {
		fill: none;
		stroke: var(--c-text);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.kd-name {
		color: var(--c-heading);
		font-family: var(--font-heading);
		font-size: var(--fs-body);
		font-weight: 700;
		line-height: var(--lh-tight);
	}
	.kd-badge {
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--c-accent-wash);
		color: var(--c-accent);
		font-size: 14px;
		font-weight: 700;
	}
	.kd-card--nolink .kd-badge {
		background: var(--c-accent2-wash);
		color: var(--c-accent2);
	}
	@media (min-width: 640px) {
		.kd-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
