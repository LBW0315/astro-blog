---
/*
  記事「久保建英がブラジル戦で見せたシャツの意味は？」専用の図解
  シャツの文面「Mucho ánimo, BARRE!!」を1語ずつ分けて、意味を添える（手描き風）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
  - スペイン語の1語ずつ：青磁の実線の枠
  - 意味を指す矢印：灰桜
  - いちばん下：3語を合わせた日本語訳（淡い青磁の枠）
*/
const W = 360;
const H = 330;
const rows = [
	{ y: 24, word: 'Mucho', mean: 'たくさんの', sub: '気持ちを強める' },
	{ y: 100, word: 'ánimo', mean: '元気・励まし', sub: '「¡Ánimo!」で頑張れ' },
	{ y: 176, word: 'BARRE!!', mean: 'バレ', sub: 'バレネチェアの呼び名' },
];
---

<figure class="ksw">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="ksw-title ksw-desc">
		<title id="ksw-title">「Mucho ánimo, BARRE!!」を1語ずつ分けた意味</title>
		<desc id="ksw-desc">
			Mucho は「たくさんの」で、気持ちを強める言葉。ánimo は「元気・励まし」で、「¡Ánimo!」だけでも頑張れの意味になる。BARRE!! は「バレ」で、バレネチェア選手の呼び名。3つを合わせると「頑張れ、バレ！」になる。
		</desc>
		<defs>
			<filter id="kubo-shirt-words-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="114"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#kubo-shirt-words-sketch)">
			{
				rows.map((r) => (
					<>
						<rect class="ksw-word-box" x="16" y={r.y} width="124" height="56" rx="8" />
						<path class="ksw-arrow" d={`M150 ${r.y + 28}H182M174 ${r.y + 21}L183 ${r.y + 28}L174 ${r.y + 35}`} />
					</>
				))
			}
			<path class="ksw-join" d="M180 244V270M172 262L180 271L188 262" />
			<rect class="ksw-result-box" x="40" y="276" width="280" height="44" rx="8"></rect>
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		{
			rows.map((r) => (
				<>
					<text class="ksw-word" x="78" y={r.y + 35} text-anchor="middle">
						{r.word}
					</text>
					<text class="ksw-mean" x="194" y={r.y + 24}>
						{r.mean}
					</text>
					<text class="ksw-sub" x="194" y={r.y + 46}>
						{r.sub}
					</text>
				</>
			))
		}
		<text class="ksw-result" x="180" y="304" text-anchor="middle">合わせて「頑張れ、バレ！」</text>
	</svg>
	<figcaption>シャツの文面を1語ずつ分けると、こうなる</figcaption>
</figure>

<style>
	.ksw svg {
		display: block;
		width: 100%;
		max-width: 26rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.ksw-word-box {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent);
		stroke-width: 2.4;
	}
	.ksw-arrow,
	.ksw-join {
		fill: none;
		stroke: var(--c-accent2);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ksw-result-box {
		fill: var(--c-accent-wash);
		stroke: var(--c-accent);
		stroke-width: 2.4;
	}
	.ksw-word {
		fill: var(--c-accent);
		font-family: var(--font-heading);
		font-size: 20px;
		font-weight: 700;
	}
	.ksw-mean {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
	.ksw-sub {
		fill: var(--c-text-sub);
		font-size: 15px;
	}
	.ksw-result {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
	}
</style>
