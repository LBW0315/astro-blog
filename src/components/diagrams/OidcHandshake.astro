---
/*
  記事「Astroブログを git push だけで公開する」専用の図解
  OIDC で一時キーを受け取るまでの流れ（手描き風）

  アクセスキーをどこにも保存しない、という点が伝わるように、
  最後に「保存するアクセスキー」に打ち消し線を引いています。

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
*/
type Step = { y: number; no: string; title: string; sub: string };

const BOX_X = 40;
const BOX_W = 280;
const BOX_H = 56;
const CX = 180; // 矢印の横位置

const steps: Step[] = [
	{ y: 14, no: '1', title: '「身分証」を発行', sub: 'GitHubが実行ごとに作る' },
	{ y: 102, no: '2', title: 'AWSに提示する', sub: 'STSへ送る' },
	{ y: 190, no: '3', title: '信頼ポリシーと照合', sub: 'sub と aud が一致するか' },
	{ y: 278, no: '4', title: '一時キーを受け取る', sub: '1時間で失効する' },
];

const arrow = (y1: number, y2: number) => `M${CX} ${y1}q3 ${(y2 - y1) / 2} 0 ${y2 - y1} M${CX - 6} ${y2 - 7}l6 7 6-7`;

const H = 412;
---

<figure class="oidc-shake">
	<svg viewBox={`0 0 360 ${H}`} role="img" aria-labelledby="oidc-shake-title oidc-shake-desc">
		<title id="oidc-shake-title">OIDCで一時キーを受け取るまでの流れ</title>
		<desc id="oidc-shake-desc">
			1. GitHubが実行ごとに「身分証」（IDトークン）を発行する。2. それをAWSのSTSに提示する。3. AWSが信頼ポリシーと照合し、subとaudが一致するかを確かめる。4. 一致すれば1時間で失効する一時キーを受け取る。保存するアクセスキーは、どこにもない。
		</desc>
		<defs>
			<filter id="oidc-shake-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="5"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#oidc-shake-sketch)">
			{
				steps.map((s) => (
					<g class="oh-box">
						<rect x={BOX_X} y={s.y} width={BOX_W} height={BOX_H} rx="10" />
						<circle cx={BOX_X + 28} cy={s.y + BOX_H / 2} r="14" />
					</g>
				))
			}
			<path class="oh-arrow" d={arrow(70, 98)} />
			<path class="oh-arrow" d={arrow(158, 186)} />
			<path class="oh-arrow" d={arrow(246, 274)} />

			<!-- 保存するアクセスキーは無い（鍵に打ち消し線） -->
			<path class="oh-icon" transform="translate(40 362)" d="M8 9a5 5 0 1 0 0 10a5 5 0 1 0 0-10z M13 14h13 M22 14v5 M26 14v4" />
			<path class="oh-strike" d="M44 384L74 364" />
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		{
			steps.map((s) => (
				<g>
					<text class="oh-no" x={BOX_X + 28} y={s.y + BOX_H / 2} text-anchor="middle" dominant-baseline="central">
						{s.no}
					</text>
					<text class="oh-title" x={BOX_X + 56} y={s.y + 24}>
						{s.title}
					</text>
					<text class="oh-sub" x={BOX_X + 56} y={s.y + 44}>
						{s.sub}
					</text>
				</g>
			))
		}
		<text class="oh-note" x="82" y="381">アクセスキーは、どこにも保存しない</text>
	</svg>
	<figcaption>OIDCで一時キーを受け取るまでの流れ（鍵は保存しない）</figcaption>
</figure>

<style>
	.oidc-shake svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.oh-box rect {
		fill: var(--c-surface-raised);
		stroke: var(--c-accent);
		stroke-width: 2;
	}
	.oh-box circle {
		fill: var(--c-accent-wash);
		stroke: var(--c-accent);
		stroke-width: 1.8;
	}
	.oh-icon,
	.oh-arrow,
	.oh-strike {
		fill: none;
		stroke: var(--c-text);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.oh-arrow {
		stroke: var(--c-line-strong);
		stroke-width: 2.2;
	}
	.oh-icon {
		stroke: var(--c-text-sub);
	}
	.oh-strike {
		stroke: var(--c-accent2);
		stroke-width: 2.4;
	}
	.oh-no {
		fill: var(--c-accent);
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 700;
	}
	.oh-title,
	.oh-note {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 16px;
		font-weight: 700;
	}
	.oh-sub {
		fill: var(--c-text-sub);
		font-size: 14px;
	}
	.oh-note {
		font-size: 15px;
	}
</style>
