---
/*
  記事「ハウスメーカーを調べ尽くした結果、余計に決められなくなった話 ― 家づくり記録②」専用の図解
  調べるのは私、決めるのは妻（手描き風）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
  色だけで区別しないように、役割は人の上に文字で書いています。
  - 調査担当の私：灰色の線、塗りは紙の色
  - 決裁担当の妻：青磁の塗りつぶし（決める人）
  - プレゼン：灰桜の矢印と、渡す資料

  人は、顔のない丸い頭と肩だけで描いています。
*/
const L = 90; // 私の中心
const R = 270; // 妻の中心
const HEAD_Y = 92;
const body = (x: number) => `M${x - 28} 158q0-40 28-40q28 0 28 40z`;
---

<figure class="rad">
	<svg viewBox="0 0 360 236" role="img" aria-labelledby="rad-title rad-desc">
		<title id="rad-title">調べるのは私、決めるのは妻</title>
		<desc id="rad-desc">
			左が調査担当の私。YouTubeで調べて、一生懸命プレゼンする。右が決裁担当の妻。ほとんど調べないが、決めるのは妻。私から妻へ、資料を渡す矢印が向いていて、社員が社長に企画を提案するような構図になっている。
		</desc>
		<defs>
			<filter id="researcher-and-decider-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="52"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#researcher-and-decider-sketch)">
			<!-- 私（調査担当） -->
			<g class="rad-me">
				<circle cx={L} cy={HEAD_Y} r="16"></circle>
				<path d={body(L)}></path>
			</g>
			<!-- 妻（決裁担当） -->
			<g class="rad-wife">
				<circle cx={R} cy={HEAD_Y} r="16"></circle>
				<path d={body(R)}></path>
			</g>
			<!-- 渡す資料 -->
			<g class="rad-paper">
				<rect x="168" y="70" width="26" height="32" rx="2"></rect>
				<path d="M174 80h14M174 87h14M174 94h9"></path>
			</g>
			<!-- プレゼンの矢印 -->
			<path class="rad-arrow" d="M132 124H226m-10 -8l10 8-10 8"></path>
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		<text class="rad-role" x={L} y="24" text-anchor="middle">調査担当</text>
		<text class="rad-name" x={L} y="48" text-anchor="middle">私</text>
		<text class="rad-role rad-role--wife" x={R} y="24" text-anchor="middle">決裁担当</text>
		<text class="rad-name rad-name--wife" x={R} y="48" text-anchor="middle">妻</text>
		<text class="rad-move" x="180" y="148" text-anchor="middle">プレゼン</text>

		<text class="rad-note" x={L} y="190" text-anchor="middle">YouTubeで調べる</text>
		<text class="rad-note" x={L} y="214" text-anchor="middle">一生懸命プレゼン</text>
		<text class="rad-note" x={R} y="190" text-anchor="middle">ほとんど調べない</text>
		<text class="rad-note rad-note--wife" x={R} y="214" text-anchor="middle">でも決めるのは妻</text>
	</svg>
	<figcaption>調べるのは私、決めるのは妻。社長に企画を提案する社員のような構図</figcaption>
</figure>

<style>
	.rad svg {
		display: block;
		width: 100%;
		max-width: 28rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.rad-me circle,
	.rad-me path {
		fill: var(--c-surface);
		stroke: var(--c-line-strong);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	.rad-wife circle,
	.rad-wife path {
		fill: var(--c-accent);
		stroke: var(--c-accent);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	.rad-paper rect {
		fill: var(--c-surface-raised);
		stroke: var(--c-line-strong);
		stroke-width: 2;
	}
	.rad-paper path {
		fill: none;
		stroke: var(--c-line-strong);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.rad-arrow {
		fill: none;
		stroke: var(--c-accent2);
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.rad-role {
		fill: var(--c-text-sub);
		font-size: 15px;
	}
	.rad-role--wife {
		fill: var(--c-accent);
	}
	.rad-name {
		fill: var(--c-heading);
		font-family: var(--font-heading);
		font-size: 18px;
		font-weight: 700;
	}
	.rad-name--wife {
		fill: var(--c-accent);
	}
	.rad-move {
		fill: var(--c-accent2);
		font-size: 15px;
		font-weight: 700;
	}
	.rad-note {
		fill: var(--c-text);
		font-size: 15px;
	}
	.rad-note--wife {
		fill: var(--c-accent);
		font-weight: 700;
	}
</style>
