---
/*
  記事「Cloud PractitionerからAWS SAAへ。2回目で合格するまでにやったこと」専用の図解
  CLF から SAA 合格までの道のり（手描き風・縦に一本道）

  手描き風のゆらぎは SVG フィルターで、線と図形だけにかけています（文字にはかけない）。
  色だけで区別しないように、次の組み合わせにしています。
  - 合格した段階：青磁の枠と淡い青磁の塗り＋「合格」の文字
  - 不合格の段階：灰色の点線の枠＋「不合格」の文字
  - 勉強の段階：白い枠
*/
const W = 360;
const BOX_W = 276;
const BOX_H = 44;
const GAP = 26;
const X = (W - BOX_W) / 2;
const steps = [
	{ text: 'Cloud Practitioner 合格', sub: 'CloudTechの問題集・1回で', kind: 'pass' },
	{ text: 'SAA：まず動画とハンズオン', sub: '全体像をつかむ', kind: 'study' },
	{ text: '問題集の2周目の途中で受験', sub: '', kind: 'study' },
	{ text: '1回目：不合格', sub: '', kind: 'fail' },
	{ text: '問題集を3周してから受験', sub: '', kind: 'study' },
	{ text: '2回目：ギリギリ合格', sub: '', kind: 'pass' },
] as const;
const top = (i: number) => 12 + i * (BOX_H + GAP);
const H = top(steps.length - 1) + BOX_H + 12;
---

<figure class="ssr">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="ssr-title ssr-desc">
		<title id="ssr-title">Cloud PractitionerからSAA合格までの道のり</title>
		<desc id="ssr-desc">
			まずCloud PractitionerにCloudTechの問題集で1回で合格。SAAは、最初に動画とハンズオンで全体像をつかみ、問題集の2周目の途中で受験して不合格。問題集を3周してから受け直して、2回目でギリギリ合格した。
		</desc>
		<defs>
			<filter id="saa-route-sketch" x="-5%" y="-5%" width="110%" height="110%">
				<feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="17"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#saa-route-sketch)">
			{
				steps.map((s, i) => (
					<rect class={`ssr-box ssr-box--${s.kind}`} x={X} y={top(i)} width={BOX_W} height={BOX_H} rx="10"></rect>
				))
			}
			{
				steps.slice(1).map((_, i) => {
					const y1 = top(i) + BOX_H + 4;
					const y2 = top(i + 1) - 4;
					return <path class="ssr-arrow" d={`M${W / 2} ${y1}V${y2}M${W / 2 - 6} ${y2 - 7}L${W / 2} ${y2}L${W / 2 + 6} ${y2 - 7}`}></path>;
				})
			}
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		{
			steps.map((s, i) =>
				s.sub ? (
					<>
						<text class={`ssr-text ssr-text--${s.kind}`} x={W / 2} y={top(i) + 19} text-anchor="middle">
							{s.text}
						</text>
						<text class="ssr-sub" x={W / 2} y={top(i) + 37} text-anchor="middle">
							{s.sub}
						</text>
					</>
				) : (
					<text class={`ssr-text ssr-text--${s.kind}`} x={W / 2} y={top(i) + 28} text-anchor="middle">
						{s.text}
					</text>
				),
			)
		}
	</svg>
	<figcaption>Cloud PractitionerからSAA合格までの道のり</figcaption>
</figure>

<style>
	.ssr svg {
		display: block;
		width: 100%;
		max-width: 24rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-body);
	}
	.ssr-box {
		fill: var(--c-surface);
		stroke: var(--c-line-strong);
		stroke-width: 2;
	}
	.ssr-box--pass {
		fill: var(--c-accent-wash);
		stroke: var(--c-accent);
		stroke-width: 2.5;
	}
	.ssr-box--fail {
		stroke: var(--c-text-sub);
		stroke-dasharray: 6 5;
	}
	.ssr-arrow {
		fill: none;
		stroke: var(--c-line-strong);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ssr-text {
		fill: var(--c-text);
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 700;
	}
	.ssr-text--pass {
		fill: var(--c-accent);
	}
	.ssr-text--fail {
		fill: var(--c-text-sub);
	}
	.ssr-sub {
		fill: var(--c-text-sub);
		font-size: 14px;
	}
</style>
