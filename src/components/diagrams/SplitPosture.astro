---
/*
  記事「私の最高のキーボード ― Keychron Q11 Ultra 8K」専用の図解
  机に向かう人を真上から見た図。一体型と分割で、腕と肩の形がどう変わるか。

  手描き風のゆらぎは SVG フィルター（feTurbulence + feDisplacementMap）で、
  線と図形だけにかけている。文字にはかけない。

  左右で人の位置をまったく同じにして、違うのは
  「キーボードの置き場所」と「そこへ伸びる腕の向き」だけにしている。
  色だけに頼らないよう、見出しと文言でも読み分けられるようにした。
  ※点線は使わない。点線＝「これから作る部分」の意味と混ざらないようにするため。

  スマホ幅（35rem以下）では2枚が縦に積まれる。
*/
---

<figure class="spo">
	<svg viewBox="0 0 260 262" role="img" aria-labelledby="spo-one-title spo-one-desc">
		<title id="spo-one-title">一体型キーボードを真上から見た姿勢</title>
		<desc id="spo-one-desc">
			体の正面に1枚のキーボードがあり、両腕がひじから内側に折れて中央に寄っている。肩が前に巻く形になる。
		</desc>
		<defs>
			<filter id="spo-one-sketch" x="-6%" y="-6%" width="112%" height="112%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="12"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#spo-one-sketch)">
			<rect class="spo__panel spo__panel--one" x="8" y="34" width="244" height="220" rx="15" />
			<rect class="spo__board" x="78" y="54" width="104" height="30" rx="5" />
			<ellipse class="spo__body" cx="130" cy="184" rx="62" ry="17" />
			<path class="spo__arm" d="M72 180 L66 134 L112 90 M188 180 L194 134 L148 90" />
			<circle class="spo__hand" cx="112" cy="90" r="5" />
			<circle class="spo__hand" cx="148" cy="90" r="5" />
			<circle class="spo__head" cx="130" cy="180" r="17" />
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		<text class="spo__heading spo__heading--one" x="130" y="24" text-anchor="middle">一体型キーボード</text>
		<text class="spo__label" x="130" y="224" text-anchor="middle">腕を内側に寄せる</text>
		<text class="spo__note spo__note--one" x="130" y="244" text-anchor="middle">肩が前に巻く</text>
	</svg>

	<svg viewBox="0 0 260 262" role="img" aria-labelledby="spo-split-title spo-split-desc">
		<title id="spo-split-title">分割キーボードを真上から見た姿勢</title>
		<desc id="spo-split-desc">
			キーボードが左右に分かれて肩幅に置かれ、両腕が肩からまっすぐ前に伸びている。胸が開く形になる。
		</desc>
		<defs>
			<filter id="spo-split-sketch" x="-6%" y="-6%" width="112%" height="112%">
				<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="58"></feTurbulence>
				<feDisplacementMap in="SourceGraphic" scale="3"></feDisplacementMap>
			</filter>
		</defs>

		<!-- 線と図形（手描き風のゆらぎをかける） -->
		<g filter="url(#spo-split-sketch)">
			<rect class="spo__panel spo__panel--split" x="8" y="34" width="244" height="220" rx="15" />
			<rect class="spo__board" x="40" y="54" width="64" height="30" rx="5" />
			<rect class="spo__board" x="156" y="54" width="64" height="30" rx="5" />
			<ellipse class="spo__body" cx="130" cy="184" rx="62" ry="17" />
			<path class="spo__arm" d="M72 180 L69 134 L72 90 M188 180 L191 134 L188 90" />
			<circle class="spo__hand" cx="72" cy="90" r="5" />
			<circle class="spo__hand" cx="188" cy="90" r="5" />
			<circle class="spo__head" cx="130" cy="180" r="17" />
		</g>

		<!-- 文字（ゆらぎをかけない） -->
		<text class="spo__heading spo__heading--split" x="130" y="24" text-anchor="middle">分割キーボード</text>
		<text class="spo__label" x="130" y="224" text-anchor="middle">肩幅のまま置ける</text>
		<text class="spo__note spo__note--split" x="130" y="244" text-anchor="middle">胸が開く</text>
	</svg>

	<figcaption>真上から見た図。キーボードを離して置けると、腕を内側に寄せなくて済む</figcaption>
</figure>

<style>
	.spo {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		max-width: 40rem;
		margin-inline: auto;
	}
	.spo svg {
		display: block;
		flex: 1 1 0;
		min-width: 0;
		height: auto;
		font-family: var(--font-body);
	}
	.spo figcaption {
		flex: 0 0 100%;
	}

	/* 枠 */
	.spo__panel {
		fill: var(--c-surface);
		stroke-width: 1.5;
	}
	.spo__panel--one {
		stroke: var(--c-accent2);
	}
	.spo__panel--split {
		stroke: var(--c-accent);
	}

	/* 人（真上から見た肩・頭・腕） */
	.spo__body,
	.spo__head,
	.spo__hand {
		fill: var(--c-surface-raised);
		stroke: var(--c-text);
		stroke-width: 1.8;
	}
	.spo__arm {
		fill: none;
		stroke: var(--c-text);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* キーボード */
	.spo__board {
		fill: var(--c-accent-wash);
		stroke: var(--c-accent);
		stroke-width: 1.8;
	}

	/* パネルの見出し */
	.spo__heading {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 16px;
	}
	.spo__heading--one {
		fill: var(--c-accent2);
	}
	.spo__heading--split {
		fill: var(--c-accent);
	}

	.spo__label {
		fill: var(--c-text);
		font-size: 14px;
	}
	.spo__note {
		font-size: 14px;
		font-weight: 700;
	}
	.spo__note--one {
		fill: var(--c-accent2);
	}
	.spo__note--split {
		fill: var(--c-accent);
	}

	/* スマホ幅では縦に積む（横並びのままだと図の中の文字が小さくなりすぎるため） */
	@media (max-width: 35rem) {
		.spo svg {
			flex-basis: 100%;
		}
	}
</style>
