---
// ページが見つからないときに表示するページ
import Icon from '../components/Icon.astro';
import Pekingese from '../components/Pekingese.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
	<div class="container container--narrow not-found">
		<Pekingese size={160} tilt />
		<p class="not-found__code">404</p>
		<h1 class="not-found__title">ページが見つかりませんでした</h1>
		<p class="not-found__text">
			URLが変わったか、削除されたのかもしれません。<br />トップページから、もう一度探してみてください。
		</p>
		<div class="not-found__actions">
			<a href="/" class="pill-link">
				<Icon name="arrow-left" size={16} />
				トップページへ
			</a>
			<a href="/blog/" class="pill-link">記事一覧を見る</a>
		</div>
	</div>
</BaseLayout>

<style>
	.not-found {
		display: grid;
		justify-items: center;
		gap: var(--sp-3);
		padding-block: var(--sp-9) var(--sp-6);
		text-align: center;
	}
	.not-found__code {
		margin-top: var(--sp-4);
		color: var(--c-text-sub);
		font-family: var(--font-heading);
		font-size: var(--fs-sm);
		letter-spacing: 0.3em;
	}
	.not-found__title {
		font-size: var(--fs-h2);
	}
	.not-found__text {
		color: var(--c-text-sub);
	}
	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--sp-3);
		margin-top: var(--sp-4);
	}
</style>
