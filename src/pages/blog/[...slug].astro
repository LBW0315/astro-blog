---
// 記事ページ（src/content/blog/ の記事ごとに1ページ作られる）
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts(); // 新しい順
	return posts.map((post) => {
		// 前後の記事は、同じジャンルの中から選ぶ
		const sameCategory = posts.filter((p) => p.data.category === post.data.category);
		const i = sameCategory.indexOf(post);
		return {
			params: { slug: post.id },
			props: { post, next: sameCategory[i - 1], prev: sameCategory[i + 1] },
		};
	});
}

interface Props {
	post: Post;
	prev?: Post;
	next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost post={post} headings={headings} prev={prev} next={next}>
	<Content />
</BlogPost>
