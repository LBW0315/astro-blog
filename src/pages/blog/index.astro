---
// 記事一覧ページ（年ごとに区切って表示）
import CategoryChip from '../../components/CategoryChip.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostGrid from '../../components/PostGrid.astro';
import { SITE_TITLE } from '../../consts';
import { categories } from '../../data/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, type Post } from '../../lib/posts';

const posts = await getPosts();

// 公開年ごとにまとめる（新しい年が先）
const byYear = new Map<number, Post[]>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const usedCategories = categories.filter((c) => posts.some((p) => p.data.category === c.slug));
---

<BaseLayout title={`記事一覧 | ${SITE_TITLE}`} description="これまでに書いた記事の一覧です。">
	<PageHeader icon="list" title="記事一覧" lead={`これまでに書いた ${posts.length} 本の記事です。`} />

	<div class="container">
		<!-- ジャンルで絞り込む（ジャンル別ページへのリンク） -->
		<nav class="filter" aria-labelledby="filter-title">
			<p id="filter-title" class="filter__title">ジャンルで絞り込む</p>
			<ul>
				{
					usedCategories.map((c) => (
						<li>
							<CategoryChip slug={c.slug} />
						</li>
					))
				}
			</ul>
		</nav>

		{
			[...byYear].map(([year, list]) => (
				<section class="year" aria-labelledby={`year-${year}`}>
					<h2 id={`year-${year}`} class="section-title">
						<Icon name="calendar" />
						{year}年<span class="year__count">{list.length}本</span>
					</h2>
					<PostGrid posts={list} />
				</section>
			))
		}
	</div>
</BaseLayout>

<style>
	.filter {
		margin-bottom: var(--sp-8);
	}
	.filter__title {
		margin-bottom: var(--sp-3);
		color: var(--c-text-sub);
		font-size: var(--fs-sm);
	}
	.filter ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.year + .year {
		margin-top: var(--sp-9);
	}
	.year__count {
		margin-left: var(--sp-2);
		color: var(--c-text-sub);
		font-family: var(--font-body);
		font-size: var(--fs-sm);
		font-weight: 400;
	}
</style>
