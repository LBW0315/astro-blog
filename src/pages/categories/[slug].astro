---
// ジャンル別の記事一覧ページ（src/data/categories.ts のジャンルごとに自動で作られる）
import CategoryChip from '../../components/CategoryChip.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostGrid from '../../components/PostGrid.astro';
import type { Category } from '../../data/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getUsedCategories, type Post } from '../../lib/posts';

// 記事が1本もないジャンルはページを作らない（中身のないページを公開しないため）
export async function getStaticPaths() {
	const posts = await getPosts();
	return getUsedCategories(posts).map((category) => ({
		params: { slug: category.slug },
		props: { category, posts: posts.filter((p) => p.data.category === category.slug), allPosts: posts },
	}));
}

interface Props {
	category: Category;
	posts: Post[];
	allPosts: Post[];
}

const { category, posts, allPosts } = Astro.props;
const usedCategories = getUsedCategories(allPosts);
---

<BaseLayout title={`${category.label}の記事`} description={category.description}>
	<PageHeader icon={category.icon} eyebrow="ジャンル" title={category.label} lead={category.description} />

	<div class="container">
		<nav class="filter" aria-label="ほかのジャンル">
			<ul>
				{
					usedCategories.map((c) => (
						<li>
							<CategoryChip slug={c.slug} current={c.slug === category.slug} />
						</li>
					))
				}
			</ul>
		</nav>

		<PostGrid posts={posts} />
	</div>
</BaseLayout>

<style>
	.filter {
		margin-bottom: var(--sp-7);
	}
	.filter ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
