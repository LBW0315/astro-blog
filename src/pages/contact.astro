---
// お問い合わせページ（Googleフォームで受け付ける。フォームはサイトの外に置き、ここからリンクする）
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { CONTACT_FORM_URL, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="お問い合わせ"
	description={`${SITE_TITLE}へのご連絡は、お問い合わせフォームで受け付けています。`}
>
	<PageHeader
		icon="chat"
		title="お問い合わせ"
		lead="記事のご感想や、間違いのご指摘などがありましたら、お問い合わせフォームからお気軽にどうぞ。"
	/>

	<div class="container container--narrow contact">
		<div class="prose" data-reveal>
			<p>
				ご連絡は、下のお問い合わせフォーム（Googleフォーム）からお願いします。お名前とメールアドレスは任意です。返信が必要な場合だけ、メールアドレスをご記入ください。
			</p>
		</div>

		<a href={CONTACT_FORM_URL} target="_blank" rel="noopener noreferrer" class="form-link" data-reveal>
			<span class="form-link__icon">
				<Icon name="chat" size={24} />
			</span>
			<span class="form-link__body">
				<span class="form-link__label">お問い合わせフォームを開く</span>
				<span class="form-link__note">Googleフォームが新しいタブで開きます</span>
			</span>
			<Icon name="arrow-right" size={18} class="form-link__arrow" />
		</a>

		<div class="prose" data-reveal>
			<h2>ご連絡の前に</h2>
			<ul>
				<li>
					いただいたメッセージにはできる限り目を通しますが、<strong>返信をお約束することはできません。</strong>
					個人で運営しているため、内容によってはお返事できない場合があります
				</li>
				<li>記事の内容に間違いを見つけた場合は、該当の記事名を添えていただけると助かります</li>
				<li>
					広告掲載や記事執筆のご依頼、営業目的のご連絡にはお応えしていません
				</li>
			</ul>
			<p>
				個人情報の取り扱いについては、<a href="/privacy/">プライバシーポリシー</a>をご覧ください。
			</p>
		</div>
	</div>
</BaseLayout>

<style>
	.contact {
		display: grid;
		gap: var(--sp-7);
	}

	.form-link {
		display: flex;
		align-items: center;
		gap: var(--sp-4);
		min-height: var(--tap);
		padding: var(--sp-4);
		border: 1px solid var(--c-line);
		border-radius: var(--radius-md);
		background: var(--c-surface-raised);
		color: inherit;
		text-decoration: none;
		transition:
			border-color var(--dur-fast) var(--ease-soft),
			transform var(--dur-press) var(--ease-soft);
	}
	.form-link:hover {
		border-color: var(--c-accent);
		transform: translateY(-2px);
	}
	.form-link__icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border-radius: var(--radius-pill);
		background: var(--c-accent-wash);
		color: var(--c-accent);
	}
	.form-link__body {
		flex: 1;
	}
	.form-link__label {
		display: block;
		color: var(--c-heading);
		font-family: var(--font-heading);
		font-weight: 700;
		line-height: 1.5;
	}
	.form-link__note {
		display: block;
		color: var(--c-text-sub);
		font-size: var(--fs-sm);
		line-height: 1.5;
	}
	.form-link__arrow {
		flex-shrink: 0;
		color: var(--c-text-faint);
	}
</style>
