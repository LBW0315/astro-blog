---
// トップページ
import CategoryChip from '../components/CategoryChip.astro';
import Icon from '../components/Icon.astro';
import PostGrid from '../components/PostGrid.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { SITE_DESCRIPTION, SITE_SUBTITLE_EN, SITE_SUBTITLE_JA, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { categories } from '../data/categories';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 6);
// ジャンルごとの記事数
const counts = Object.fromEntries(
	categories.map((c) => [c.slug, posts.filter((p) => p.data.category === c.slug).length]),
);
---

<BaseLayout description={SITE_DESCRIPTION}>
	<!-- ヒーロー：サイト名と「継続は力なり」 -->
	<section class="hero">
		<div class="container hero__inner">
			<p class="hero__eyebrow">
				<Icon name="pen" size={16} />
				{SITE_TAGLINE}
			</p>
			<h1 class="hero__title">{SITE_TITLE}</h1>
			<p class="hero__sub">
				<span class="hero__sub-en">{SITE_SUBTITLE_EN}</span>
				<span class="hero__sub-ja">{SITE_SUBTITLE_JA}</span>
			</p>
			<span class="hero__line" aria-hidden="true"></span>
			<p class="hero__lead">
				技術のこと、数学のこと、好きな道具のこと。<br class="hero__br" />
				一歩ずつ、こつこつ書き続けていきます。
			</p>
		</div>
		<!-- 背景の飾り：方眼ノートのマス目と、淡いインクのしみ -->
		<div class="hero__deco" aria-hidden="true"></div>
	</section>

	<div class="container home">
		<section aria-labelledby="latest-title">
			<h2 id="latest-title" class="section-title">
				<Icon name="notebook" />
				新しい記事
			</h2>
			<PostGrid posts={latest} />
			{
				posts.length > latest.length && (
					<p class="home__more">
						<a href="/blog/" class="pill-link">
							記事をすべて見る
							<Icon name="arrow-right" size={16} />
						</a>
					</p>
				)
			}
		</section>

		<section aria-labelledby="genre-title">
			<h2 id="genre-title" class="section-title">
				<Icon name="grid" />
				ジャンル
			</h2>
			<ul class="home__genres" data-reveal>
				{
					categories.map((c) => (
						<li>
							<CategoryChip slug={c.slug} count={counts[c.slug]} />
						</li>
					))
				}
			</ul>
		</section>

		<section aria-label="プロフィール">
			<ProfileCard />
		</section>
	</div>
</BaseLayout>

<style>
	/* ----- ヒーロー ----- */
	.hero {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--c-line);
	}
	.hero__inner {
		position: relative;
		z-index: 1;
		padding-block: var(--sp-9) var(--sp-8);
	}
	.hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--sp-2);
		padding: var(--sp-1) var(--sp-4);
		border-radius: var(--radius-pill);
		background: var(--c-accent-wash);
		color: var(--c-accent);
		font-family: var(--font-heading);
		font-size: var(--fs-sm);
		font-weight: 700;
		letter-spacing: 0.12em;
	}
	/* サイト名：ロゴと同じ細めの英字を大きく */
	.hero__title {
		margin-top: var(--sp-5);
		margin-right: calc(var(--ls-logo) * -1);
		font-family: var(--font-logo);
		font-size: var(--fs-display);
		font-weight: var(--fw-logo);
		letter-spacing: var(--ls-logo);
		line-height: 1.15;
	}
	.hero__sub {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--sp-1) var(--sp-4);
		margin-top: var(--sp-3);
	}
	/* 英語サブタイトル：小さめ */
	.hero__sub-en {
		color: var(--c-text-sub);
		font-family: var(--font-logo);
		font-size: 0.875rem;
		letter-spacing: 0.16em;
	}
	/* 日本語サブタイトル：淡いグレーで控えめに（コントラスト比 5.08:1） */
	.hero__sub-ja {
		color: var(--c-text-faint);
		font-size: var(--fs-sm);
		letter-spacing: 0.08em;
	}
	/* インクで線を引くように、左から一度だけ伸びる */
	.hero__line {
		display: block;
		width: 96px;
		height: 3px;
		margin-top: var(--sp-4);
		border-radius: 3px;
		background: var(--c-accent);
		transform-origin: left center;
		animation: hero-draw var(--dur-slower) var(--ease-soft) 0.25s backwards;
	}
	@keyframes hero-draw {
		from {
			transform: scaleX(0);
		}
	}
	.hero__lead {
		margin-top: var(--sp-5);
		color: var(--c-text-sub);
		font-size: var(--fs-lead);
		line-height: 1.9;
		animation: hero-fade var(--dur-slow) var(--ease-soft) 0.35s backwards;
	}
	@keyframes hero-fade {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}
	.hero__br {
		display: none;
	}
	@media (min-width: 640px) {
		.hero__br {
			display: inline;
		}
	}
	/* 右側に、方眼のマス目を円形にふんわり表示（動かない飾り） */
	.hero__deco {
		position: absolute;
		top: 50%;
		right: -80px;
		width: min(520px, 90vw);
		aspect-ratio: 1;
		translate: 0 -50%;
		background-image:
			linear-gradient(var(--c-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--c-line) 1px, transparent 1px);
		background-size: 24px 24px;
		mask-image: radial-gradient(circle, #000 20%, transparent 68%);
		-webkit-mask-image: radial-gradient(circle, #000 20%, transparent 68%);
		opacity: 0.8;
	}

	/* ----- 本体 ----- */
	.home {
		display: grid;
		gap: var(--sp-9);
		padding-top: var(--sp-8);
	}
	.home__more {
		margin-top: var(--sp-6);
		text-align: center;
	}
	.home__genres {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
